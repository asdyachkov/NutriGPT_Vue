    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.0",
